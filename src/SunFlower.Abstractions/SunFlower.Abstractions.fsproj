        <Compile Include="FlowerReflection.fs"/>
        <Compile Include="FlowerVersionContractAttribute.fs" />
        <Compile Include="IFlower.fs" />
        <Compile Include="SeedAttribute.fs" />
    </ItemGroup>

</Project>
