<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:view="clr-namespace:SunFlower.Client.View"
             xmlns:client="clr-namespace:SunFlower.Client"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:dock="clr-namespace:SunFlower.Client.ViewModel.Dock"
             xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:vm="clr-namespace:SunFlower.Client.ViewModel"
             x:DataType="{x:Type client:App}"
             x:Class="SunFlower.Client.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Application metadata -->
            <system:String x:Key="AppVersion">5.0.0-rc</system:String>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Drawing/CloudsBrush.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <view:ViewLocator x:Key="ViewLocator" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <StyleInclude Source="avares://AvaloniaHex/Themes/Fluent/AvaloniaHex.axaml" />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="/Drawing/DocumentTheme.axaml" />
        <FluentTheme />
        <DockFluentTheme />
        <StyleInclude Source="/Drawing/DockTheme.axaml" />
        <StyleInclude Source="avares://HandyControl/Themes/Theme.axaml" />
    </Application.Styles>

    <Application.DataTemplates>
        <!-- <DataTemplate -->
        <!--     DataType="{x:Type dock:MarkdownDocumentViewModel}"> -->
        <!--     <mdxaml:MarkdownScrollViewer -->
        <!--         Margin="10" -->
        <!--         Markdown="{Binding Content}"> -->
        <!--         <mdxaml:MarkdownScrollViewer.Styles> -->
        <!--             <StyleInclude Source="/Drawing/DocumentTheme.axaml" /> -->
        <!--         </mdxaml:MarkdownScrollViewer.Styles> -->
        <!--     </mdxaml:MarkdownScrollViewer> -->
        <!-- </DataTemplate> -->
        <!-- <DataTemplate -->
        <!--     DataType="{x:Type dock:HexDocumentViewModel}"> -->
        <!--     <view:HexDocumentView -->
        <!--         FontFamily="{CompiledBinding HexFontFamily}" -->
        <!--         FontSize="{CompiledBinding HexFontSize}"/> -->
        <!-- </DataTemplate> -->
        <!-- <DataTemplate DataType="{x:Type dock:TextDocumentViewModel}"> -->
        <!--     <view:TextDocumentView -->
        <!--         FontFamily="{CompiledBinding TextFontFamily}" -->
        <!--         FontSize="{CompiledBinding TextFontSize}"/> -->
        <!-- </DataTemplate> -->
        <!-- -->
        <!-- <DataTemplate DataType="{x:Type dock:ExplorerDocumentViewModel}"> -->
        <!--     <view:ExplorerDocumentView /> -->
        <!-- </DataTemplate> -->
        <!-- -->
        <!-- <DataTemplate DataType="{x:Type vm:ExecuteDialogViewModel}"> -->
        <!--     <view:ExecuteDialogView /> -->
        <!-- </DataTemplate> -->
        
        <view:ViewLocator/>
    </Application.DataTemplates>
</Application>