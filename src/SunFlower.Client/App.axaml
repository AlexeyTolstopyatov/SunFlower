        <!--             <StyleInclude Source="/Drawing/DocumentTheme.axaml" /> -->
        <!--         </md:MarkdownScrollViewer.Styles> -->
        <!--     </md:MarkdownScrollViewer> -->
        <!-- </DataTemplate> -->
        <!-- <DataTemplate  -->
        <!--     DataType="{x:Type dock:HexDocumentViewModel}"> -->
        <!--     <view:HexDocumentView  -->
        <!--         FontFamily="{CompiledBinding HexFontFamily}" -->
        <!--         FontSize="{CompiledBinding HexFontSize}"/> -->
        <!-- </DataTemplate> -->
        <!-- <DataTemplate DataType="{x:Type dock:TextDocumentViewModel}"> -->
        <!--     <view:TextDocumentView  -->
        <!--         FontFamily="{CompiledBinding TextFontFamily}" -->
        <!--         FontSize="{CompiledBinding TextFontSize}"/> -->
        <!-- </DataTemplate> -->
