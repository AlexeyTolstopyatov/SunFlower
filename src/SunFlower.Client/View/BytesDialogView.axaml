<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SunFlower.Client.ViewModel"
             mc:Ignorable="d"
             x:Class="SunFlower.Client.View.BytesDialogView"
             x:DataType="{x:Type vm:BytesDialogViewModel}">
    <!--
        Bytes converter dialog.
        Left side  -> hex dump of the selected bytes
        Right side -> table of interpreted formats (ASCII, UTF-8, UTF-16, codepages, integers LSB/MSB)
    -->
    <Grid
        ColumnDefinitions="*,*"
        RowDefinitions="*,Auto"
        Margin="10">

        <!-- hex dump -->
        <Border
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,5,0"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Padding="8">
            <Grid
                RowDefinitions="Auto,*,Auto">
                <TextBlock
                    Grid.Row="0"
                    Text="Hex Dump"
                    FontWeight="SemiBold"
                    Margin="0,0,0,6" />

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <TextBox
                        VerticalContentAlignment="Top"
                        Padding="10"
                        Text="{Binding HexDump}"
                        FontFamily="{CompiledBinding Font}"
                        FontSize="{CompiledBinding Size}"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </ScrollViewer>

                <TextBlock
                    Grid.Row="2"
                    Text="{Binding BytesInfo}"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Margin="0,10,0,0"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- RIGHT: formats table -->
        <Border
            Grid.Row="0"
            Grid.Column="1"
            Margin="5,0,0,0"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Padding="8">
            <Grid
                RowDefinitions="Auto,*">
                <TextBlock
                    Grid.Row="0"
                    Text="Interpreted formats"
                    FontWeight="SemiBold"
                    Margin="0,0,0,5" />

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl
                        ItemsSource="{Binding Formats}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    ColumnDefinitions="100,*,*"
                                    Margin="0,2">
                                    <SelectableTextBlock
                                        Margin="2,0"
                                        Grid.Column="0"
                                        Text="{Binding Name}"
                                        FontWeight="Medium" />
                                    <SelectableTextBlock
                                        Margin="2,0"
                                        Grid.Column="1"
                                        Text="{Binding Value}" />
                                    <SelectableTextBlock
                                        Margin="2,0"
                                        Grid.Column="2"
                                        Text="{CompiledBinding SignedValue}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="0,8,0,0">
            <Grid
                ColumnDefinitions="Auto,Auto">
                <Button
                    Grid.Column="0"
                    MinWidth="100"
                    Content="Copy Hex Dump"
                    Command="{Binding CopyHexCommand}" />

                <Button
                    Grid.Column="1"
                    MinWidth="90"
                    Content="Close"
                    Command="{Binding CancelCommand}"
                    HotKey="Escape"
                    HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</UserControl>