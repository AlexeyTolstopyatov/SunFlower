<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SunFlower.Client.ViewModel"
             xmlns:wm="clr-namespace:SunFlower.Client.ViewModel.Dock"
             xmlns:view="clr-namespace:SunFlower.Client.View"
             xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:avalonia="https://github.com/whistyun/Markdown.Avalonia.Tight"
             xmlns:dock="clr-namespace:SunFlower.Client.View.Dock"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="768"
             x:DataType="{x:Type vm:DockWorkspaceViewModel}"
             x:Class="SunFlower.Client.View.DockWorkspaceView">
    <Grid>
        <DockControl
            Layout="{CompiledBinding Layout}">
            
        </DockControl>
    </Grid>
</UserControl>