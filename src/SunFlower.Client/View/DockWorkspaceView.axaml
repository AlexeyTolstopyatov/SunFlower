<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SunFlower.Client.ViewModel"
             xmlns:wm="clr-namespace:SunFlower.Client.ViewModel.Dock"
             xmlns:view="clr-namespace:SunFlower.Client.View"
             xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:avalonia="https://github.com/whistyun/Markdown.Avalonia.Tight"
             mc:Ignorable="d"
             d:DesignWidth="1280"
             d:DesignHeight="768"
             x:DataType="{x:Type vm:DockWorkspaceViewModel}"
             x:Class="SunFlower.Client.View.DockWorkspaceView">
    <Grid>
        <DockControl
            Layout="{CompiledBinding Layout}">
            <DockControl.DataTemplates>
                <DataTemplate 
                    x:DataType="{x:Type wm:ExplorerDocumentViewModel}">
                    <view:ExplorerDocumentView/>
                </DataTemplate>
                <DataTemplate x:DataType="{x:Type wm:HexDocumentViewModel}">
                    <view:HexDocumentView
                        FontFamily="{CompiledBinding HexFontFamily}"
                        FontSize="{CompiledBinding HexFontSize}"/>
                </DataTemplate>
                <DataTemplate x:DataType="{x:Type wm:TextDocumentViewModel}">
                    <view:TextDocumentView
                        FontFamily="{CompiledBinding TextFontFamily}"
                        FontSize="{CompiledBinding TextFontSize}"/>
                </DataTemplate>
                <DataTemplate 
                    x:DataType="{x:Type wm:MarkdownDocumentViewModel}">
                    <mdxaml:MarkdownScrollViewer 
                        Margin="10" 
                        Markdown="{Binding Content}">
                        <avalonia:MarkdownScrollViewer.Styles>
                            <StyleInclude Source="/Drawing/DocumentTheme.axaml" />
                        </avalonia:MarkdownScrollViewer.Styles>
                    </mdxaml:MarkdownScrollViewer>
                </DataTemplate>
            </DockControl.DataTemplates>
        </DockControl>
    </Grid>
</UserControl>