             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="clr-namespace:SunFlower.Client.ViewModel.Dock"
             xmlns:vm="clr-namespace:SunFlower.Client.ViewModel"
             xmlns:kernel="clr-namespace:SunFlower.Kernel.Services;assembly=SunFlower.Kernel"
             x:Name="Root" x:Class="SunFlower.Client.View.ExplorerDocumentView"
             x:DataType="dock:ExplorerDocumentViewModel">
