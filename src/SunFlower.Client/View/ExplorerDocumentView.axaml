    <!--                 <DataTemplate x:DataType="viewModel:ProjectFileViewModel"> -->
    <!--                     <StackPanel Orientation="Horizontal" Spacing="8"> -->
    <!--                         <TextBlock  -->
    <!--                             Text="{Binding FileName}" /> -->
    <!--                         <Interaction.Behaviors> -->
    <!--                             <DoubleTappedGestureTrigger> -->
    <!--                                 <InvokeCommandAction Command="{Binding ElementName=ProjectFileList, Path=((vm:ExplorerDocumentViewModel)DataContext).OpenSelectedFileCommand}" /> -->
    <!--                             </DoubleTappedGestureTrigger> -->
    <!--                         </Interaction.Behaviors> -->
