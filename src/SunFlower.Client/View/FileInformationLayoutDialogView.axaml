<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SunFlower.Client.ViewModel"
             mc:Ignorable="d" d:DesignWidth="450"
             x:Class="SunFlower.Client.View.FileInformationLayoutDialogView"
             x:DataType="{x:Type vm:FileInformationLayoutDialogViewModel}">
    <StackPanel
        Spacing="5">
        <Interaction.Behaviors>
            <KeyTrigger
                Key="Escape">
                <InvokeCommandAction
                    Command="{CompiledBinding ExitCommand}"/>
            </KeyTrigger>
        </Interaction.Behaviors>
        <TextBlock
            FontWeight="Bold"
            FontSize="21"
            TextWrapping="WrapWithOverflow"
            Text="{Binding FlowerFileInfo.Name, FallbackValue='File'}" />
        <Border
            Margin="10"
            CornerRadius="6"
            BorderBrush="{DynamicResource BorderBrush}">
            <StackPanel>
                <ProgressBar 
                    IsIndeterminate="True" 
                    IsVisible="{Binding IsFileSystemBusy}" />
                <ItemsControl 
                    ItemsSource="{Binding FileSystemRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid 
                                ColumnDefinitions="160,*">
                                <TextBlock 
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Text="{Binding Key}"/>
                                <SelectableTextBlock 
                                    Grid.Column="1" 
                                    Text="{Binding Value}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
        <Separator/>
        <Border
            Margin="10"
            CornerRadius="6"
            BorderBrush="{DynamicResource BorderBrush}">
            <Grid
                ColumnDefinitions="160,Auto">
                <StackPanel>
                    <TextBlock
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="Defined Type" />
                    <TextBlock
                        Foreground="{DynamicResource SecondaryTextBrush}"
                        Text="Binary Definition" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1">
                    <SelectableTextBlock
                        FontSize="14"
                        FontFamily="Sans Serif"
                        Text="{CompiledBinding FlowerFileInfo.Type, FallbackValue='?'}" />
                    <SelectableTextBlock
                        FontSize="14"
                        FontFamily="Sans Serif"
                        Text="{CompiledBinding FlowerFileInfo.Sign, FallbackValue='?'}" />
                </StackPanel>
            </Grid>
        </Border>
        <Separator />
        <Border
            Margin="10"
            CornerRadius="6"
            BorderBrush="{DynamicResource BorderBrush}">
            <StackPanel>
                <ProgressBar 
                    IsIndeterminate="True" 
                    IsVisible="{Binding IsStringsBusy}" />
                <ItemsControl 
                    ItemsSource="{Binding StringsRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid 
                                ColumnDefinitions="160,*">
                                <TextBlock 
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    Text="{Binding Key}"/>
                                <SelectableTextBlock 
                                    Grid.Column="1" 
                                    Text="{Binding Value}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>