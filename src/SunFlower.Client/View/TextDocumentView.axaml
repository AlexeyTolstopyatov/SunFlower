<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:edit="https://github.com/avaloniaui/avaloniaedit"
             xmlns:vm="clr-namespace:SunFlower.Client.ViewModel"
             xmlns:dock="clr-namespace:SunFlower.Client.ViewModel.Dock"
             mc:Ignorable="d"
             d:DesignWidth="400"
             d:DesignHeight="300"
             x:Class="SunFlower.Client.View.TextDocumentView"
             x:DataType="{x:Type dock:TextDocumentViewModel}">
    <edit:TextEditor
        x:Name="Editor"
        Margin="10"
        FontFamily="{Binding TextFontFamily}"
        FontSize="{Binding TextFontSize}"
        Document="{Binding TextDocument}" />
</UserControl>