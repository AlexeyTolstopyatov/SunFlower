<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:vm="clr-namespace:SunFlower.Client.ViewModel"
              xmlns:k="clr-namespace:SunFlower.Kernel.Services;assembly=SunFlower.Kernel"
              xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
              xmlns:edit="https://github.com/avaloniaui/avaloniaedit"
              xmlns:hexr="clr-namespace:AvaloniaHex.Rendering;assembly=AvaloniaHex"
              xmlns:hex="clr-namespace:AvaloniaHex;assembly=AvaloniaHex"
              mc:Ignorable="d" 
              d:DesignWidth="1024" 
              d:DesignHeight="600"
              Background="Transparent"
              x:Name="Workspace"
              x:Class="SunFlower.Client.View.WorkspaceView"
              x:DataType="{x:Type vm:WorkspaceViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- project explorer & plugins -->
            <ColumnDefinition
                Width="250" />
            
            <ColumnDefinition
                Width="3"/>
            <!-- active content -->
            <ColumnDefinition 
                MinWidth="400" 
                Width="*" />
            
            <ColumnDefinition
                Width="3"/>
            
            <ColumnDefinition 
                MinWidth="280"
                MaxWidth="500"
                Width="360" />
        </Grid.ColumnDefinitions>
        
        <StackPanel>
            <Grid
                Margin="10"
                ColumnDefinitions="48, *">
                <Image
                    Source="/Assets/app48.png"/>
                <StackPanel
                    VerticalAlignment="Center"
                    Margin="10,30"
                    Grid.Column="1">
                    <TextBlock
                        VerticalAlignment="Center">
                        <Run
                            Text="{CompiledBinding FileName}"/>
                        <LineBreak/>
                        <Run
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{CompiledBinding ProjectFiles.Count, StringFormat='Files: {0}', FallbackValue=0}"/>
                        <LineBreak/>
                        <Run
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{CompiledBinding ProjectDirectory, FallbackValue=No project}"/>
                        <LineBreak/>
                        <Run
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{CompiledBinding WorkspaceService.CurrentProject.IsDirty, StringFormat='Not saved: {0}', FallbackValue=False}"/>
                        <LineBreak/>
                        <Run
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="{CompiledBinding WorkspaceService.CurrentProject.IsProject, StringFormat='Is project: {0}', FallbackValue=False}"/>
                        <LineBreak/>
                    </TextBlock>
                </StackPanel>
            </Grid>
            
            <Menu>
                <Menu.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </Menu.ItemsPanel>
                <MenuItem
                    HotKey="Ctrl+Shift+S"
                    Command="{CompiledBinding SaveProjectCommand}">
                    <MenuItem.Icon>
                        <Image Source="/Assets/edit48.png"/>
                    </MenuItem.Icon>
                    <MenuItem.Header>
                        <TextBlock
                            FontSize="12">
                            <Run
                                Text="Save Project"/>
                            <Run
                                Text="{CompiledBinding $parent[MenuItem].HotKey}"
                                Foreground="{StaticResource SecondaryTextBrush}"/>
                        </TextBlock>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem
                    Command="{CompiledBinding ExportFileCommand}"
                    CommandParameter="{CompiledBinding SelectedProjectFile}"
                    HotKey="Ctrl+Alt+S">
                    <MenuItem.Icon>
                        <Image Source="/Assets/dir48.png"/>
                    </MenuItem.Icon>
                    <MenuItem.Header>
                        <TextBlock 
                            FontSize="12">
                            <Run
                                Text="Export File"/>
                            <Run
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="{CompiledBinding $parent[MenuItem].HotKey}"/>
                        </TextBlock>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem
                    HotKey="Ctrl+Shift+B"
                    CommandParameter="{CompiledBinding ElementName=HexViewer}"
                    Command="{CompiledBinding ExtractHexSelectionCommand}">
                    <MenuItem.Header>
                        <TextBlock
                            FontSize="12">
                            <Run
                                Text="Save Selection As"/>
                            <Run
                                Text="{CompiledBinding $parent[MenuItem].HotKey}"
                                Foreground="{StaticResource SecondaryTextBrush}"/>
                        </TextBlock>
                    </MenuItem.Header>
                    <MenuItem.Icon>
                        <Image
                            Width="48"
                            Source="/Assets/fbin48.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                
                <MenuItem
                    HotKey="Ctrl+B"
                    Command="{CompiledBinding ShowDisassemblerDialogCommand}">
                    <MenuItem.Header>
                        <TextBlock
                            FontSize="12">
                            <Run
                                Text="Translate Binary"/>
                            <Run
                                Text="{CompiledBinding $parent[MenuItem].HotKey}"
                                Foreground="{StaticResource SecondaryTextBrush}"/>
                        </TextBlock>
                    </MenuItem.Header>
                    <MenuItem.Icon>
                        <Image Source="/Assets/code48.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                
                <MenuItem
                    HotKey="Ctrl+T"
                    Command="{CompiledBinding ShowDisassemblerSelectionDialogCommand}"
                    CommandParameter="{CompiledBinding ElementName=HexViewer}">
                    <MenuItem.Icon>
                        <Image Source="/Assets/code48.png"/>
                    </MenuItem.Icon>
                    <MenuItem.Header>
                        <TextBlock
                            FontSize="12">
                            <Run
                                Text="Translate Selection"/>
                            <Run
                                Text="{CompiledBinding $parent[MenuItem].HotKey}"
                                Foreground="{StaticResource SecondaryTextBrush}"/>
                        </TextBlock>
                    </MenuItem.Header>
                </MenuItem>
                
                <MenuItem
                    HotKey="Ctrl+J"
                    CommandParameter="{CompiledBinding ElementName=HexViewer}"
                    Command="{CompiledBinding ShowGoToAddressDialogCommand}">
                    <MenuItem.Icon>
                        <Image Source="/Assets/fbin48.png"/>
                    </MenuItem.Icon>
                    <MenuItem.Header>
                        <TextBlock
                            FontSize="12">
                            <Run
                                Text="Jump At"/>
                            <Run
                                Text="{CompiledBinding $parent[MenuItem].HotKey}"
                                Foreground="{StaticResource SecondaryTextBrush}"/>
                        </TextBlock>
                    </MenuItem.Header>
                </MenuItem>
            </Menu>
        </StackPanel>
        
        <GridSplitter
            Background="{StaticResource BorderBrush}"
            Grid.Column="1"/>
        <GridSplitter
            Background="{StaticResource BorderBrush}"
            Grid.Column="3"/>
        
        <Grid
            Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition 
                    Height="*" />
            </Grid.RowDefinitions>

            <!-- Project files -->
            <StackPanel
                Background="{DynamicResource CloudTileBrush}"
                Grid.Row="0">
                <Border
                    Margin="20"
                    Padding="10"
                    CornerRadius="10"
                    Background="{DynamicResource BorderBrush}">
                    <ListBox
                        ItemsSource="{CompiledBinding ProjectFiles}"
                        SelectedItem="{CompiledBinding SelectedProjectFile, Mode=TwoWay}"
                        BorderBrush="Transparent"
                        Background="Transparent">
                        <Interaction.Behaviors>
                            <EventTriggerBehavior EventName="DoubleTapped">
                                <InvokeCommandAction Command="{CompiledBinding OpenProjectFileCommand}" />
                            </EventTriggerBehavior>
                        </Interaction.Behaviors>
                        <ListBox.ItemTemplate>
                            <DataTemplate 
                                x:DataType="vm:ProjectFileItem">
                                <Grid>
                                    <Interaction.Behaviors>
                                        <EventTriggerBehavior EventName="ContextRequested">
                                            <InvokeCommandAction
                                                Command="{CompiledBinding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).SetActiveProjectFileCommand, FallbackValue=Close}"
                                                CommandParameter="{Binding}"/>
                                        </EventTriggerBehavior>
                                    </Interaction.Behaviors>
                                    <Grid
                                        ColumnDefinitions="24, *">
                                        <Image
                                            Source="/Assets/file48.png"
                                            Width="24"/>
                                        <StackPanel 
                                            VerticalAlignment="Center"
                                            Grid.Column="1" 
                                            Margin="5,0">
                                            <TextBlock
                                                TextWrapping="NoWrap">
                                                <Run Text="{CompiledBinding Name}"/>
                                                <Run
                                                    Text="{Binding Size}" 
                                                    Foreground="{StaticResource SecondaryTextBrush}"></Run>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                Header="Open"
                                                Command="{CompiledBinding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).OpenProjectFileCommand, FallbackValue=Close}"
                                                CommandParameter="{Binding}"/>
                                            <MenuItem
                                                Header="Save"
                                                Command="{CompiledBinding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).SaveActiveFileCommand, FallbackValue=Close}"/>
                                            <!-- <Separator/> -->
                                            <MenuItem
                                                Header="Rename"
                                                Command="{CompiledBinding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).RenameProjectFileCommand, FallbackValue=Close}"
                                                CommandParameter="{Binding}"/>
                                            <MenuItem
                                                Header="Delete"
                                                Command="{CompiledBinding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).DeleteProjectFileCommand, FallbackValue=Close}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanDelete}"/>
                                            <!-- <Separator/> -->
                                            <MenuItem
                                                Header="Run plugin"
                                                ItemsSource="{CompiledBinding $parent[UserControl].((vm:WorkspaceViewModel)DataContext).AvailablePlugins, FallbackValue=[]}">
                                                <MenuItem.ItemTemplate>
                                                    <DataTemplate>
                                                        <MenuItem
                                                            Header="{CompiledBinding Instance.Name}"
                                                            Command="{CompiledBinding ElementName=Workspace, Path=((vm:WorkspaceViewModel)DataContext).ApplyPluginToProjectFileCommand, FallbackValue=Close}"
                                                            CommandParameter="{Binding .}">
                                                            <MenuItem.Icon>
                                                                <Image Source="/Assets/sunflower256.png"/>
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </DataTemplate>
                                                </MenuItem.ItemTemplate>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Splitter -->
        <GridSplitter 
            Grid.Column="1" 
            Background="{StaticResource BorderBrush}" />
        <Grid
            Grid.Column="2">
            <!-- Main content area -->
            <md:MarkdownScrollViewer
                Margin="20" 
                IsEnabled="{Binding IsMarkdownView}"
                IsVisible="{Binding IsMarkdownView}"
                Markdown="{Binding ActiveContentText}">
                <md:MarkdownScrollViewer.Styles>
                    <StyleInclude Source="/Drawing/MarkdownRenderStyles.axaml" />
                </md:MarkdownScrollViewer.Styles>
            </md:MarkdownScrollViewer>
            <edit:TextEditor
                x:Name="Editor"
                Margin="20"
                FontSize="{CompiledBinding TextFontSize}"
                FontFamily="{CompiledBinding TextFontFamily}"
                IsEnabled="{Binding IsAssemblyView}"
                IsVisible="{Binding IsAssemblyView}"
                Document="{Binding ActiveTextDocument}">
            </edit:TextEditor>
            <hex:HexEditor
                x:Name="HexViewer"
                IsVisible="{Binding IsBinaryView}"
                IsEnabled="{Binding IsBinaryView}"
                FontSize="{CompiledBinding  HexFontSize}"
                FontFamily="{CompiledBinding HexFontFamily}"
                Padding="10"
                Document="{Binding ActiveBinaryDocument}">
                <!-- Define columns to display -->
                <hex:HexEditor.Columns>
                    <hexr:OffsetColumn/>
                    <hexr:HexColumn 
                        UseDynamicHeader="True"/>
                    <hexr:AsciiColumn/>
                </hex:HexEditor.Columns>
                <hex:HexEditor.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Header="Save fragment"
                            Command="{Binding ExtractHexSelectionCommand}"
                            CommandParameter="{Binding ElementName=HexViewer}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/fbin48.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem
                            Header="Disassemble fragment"
                            Command="{CompiledBinding ShowDisassemblerSelectionDialogCommand}"
                            CommandParameter="{CompiledBinding ElementName=HexViewer}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/code48.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem
                            Header="Jump at"
                            CommandParameter="{CompiledBinding ElementName=HexViewer}"
                            Command="{CompiledBinding ShowGoToAddressDialogCommand}">
                            <MenuItem.Icon>
                                <Image Source="/Assets/fbin48.png"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </hex:HexEditor.ContextMenu>
            </hex:HexEditor>
        </Grid>
    </Grid>
</UserControl>