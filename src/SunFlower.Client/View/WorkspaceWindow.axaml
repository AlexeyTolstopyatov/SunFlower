<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SunFlower.Client.ViewModel"
        xmlns:view="clr-namespace:SunFlower.Client.View"
        mc:Ignorable="d" 
        d:DesignWidth="1024" 
        d:DesignHeight="768"
        x:Class="SunFlower.Client.View.WorkspaceWindow"
        Icon="/Assets/app48.png"
        Background="{StaticResource RegionBrush}"
        Title="Workspace"
        x:DataType="{x:Type vm:DockWorkspaceViewModel}"
        Closing="OnClosing">
    <Grid>
        <Grid.KeyBindings>
            <KeyBinding
                Gesture="Ctrl+Shift+P"
                Command="{CompiledBinding ShowCommandPaletteCommand}"/>
        </Grid.KeyBindings>
        <view:DockWorkspaceView 
            x:Name="DockingWorkspace" 
            DataContext="{Binding}" />
        
        <Border 
            x:Name="DialogLayer"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Background="#80000000"
            IsVisible="False">
        </Border>

        <!-- Long-running routine overlay -->
        <!--
             Want to see preview details? See WorkspaceView instead :D
             Anyway if you set FallbackValue to False, nothing changes at the runtime
        -->
        <Border
            x:Name="BusyLayer"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Background="#80000000"
            IsVisible="{Binding Path=IsBusy}"
            >
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <ProgressBar
                    Width="240"
                    IsIndeterminate="True" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Text="{Binding BusyText}" />
            </StackPanel>
        </Border>

        <Popup 
            x:Name="DialogContainer"
            IsOpen="False"
            PlacementTarget="{Binding ElementName=DialogLayer}"
            Placement="Center"
            OverlayDismissEventPassThrough="True"
            Closed="DialogContainerClosed"
            Opened="DialogContainerOpened">
            <FlyoutPresenter
                MaxHeight="1024"
                MaxWidth="768"
                Padding="20"
                SizeChanged="DialogPresenterSizeChanged"
                x:Name="DialogPresenter">
            </FlyoutPresenter>
        </Popup>
    </Grid>
</Window>